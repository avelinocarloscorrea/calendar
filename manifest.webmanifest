{
  "name": "Calendar Studio",
  "short_name": "Calendar",
  "description": "Gere um calendário personalizado (parede, quadrado ou mesa) com suas fotos e feriados do Brasil, pronto para impressão. Roda no navegador, sem enviar nada.",
  "lang": "pt-BR",
  "start_url": "./index.html",
